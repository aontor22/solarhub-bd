# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/solarhub?sslmode=require"

# Authentication (minimum 32 random characters in production)
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store support information (shown publicly when configured)
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_BUSINESS_ADDRESS=""

# Delivery pricing in BDT
SHIPPING_FEE="150"
FREE_SHIPPING_MIN="50000"

# Optional manual payments. Leave blank to hide a method at checkout.
MANUAL_PAYMENT_BKASH_NUMBER=""
MANUAL_PAYMENT_NAGAD_NUMBER=""
MANUAL_PAYMENT_BANK_INFO=""
